# ======================================================================
# Personal AI Project Management Agent — environment variables
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# Every new variable introduced by code MUST be documented here and in
# backend/app/core/config.py (Developer A) with a matching entry.
# ======================================================================

# ---- Application ----
# development | test
APP_ENV=development
# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# Optional shared API token for the backend. Empty = no auth (local MVP only).
API_BEARER_TOKEN=

# ---- Backend ----
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
BACKEND_RELOAD=true
# Comma-separated origins allowed to call the API from the browser
CORS_ORIGINS=http://localhost:5173

# ---- Frontend ----
# Base URL the frontend uses to reach the backend API
VITE_API_BASE_URL=http://localhost:8000/api/v1

# ---- LLM / Ollama (Developer A) ----
# Local Ollama server endpoint
OLLAMA_BASE_URL=http://localhost:11434
# Model tag available in your Ollama installation (e.g. llama3.1:8b, qwen2.5:7b)
OLLAMA_MODEL=llama3.1:8b
# Seconds before an LLM call is considered failed (falls back / retries once)
LLM_TIMEOUT_SECONDS=60
# Provider used by the abstraction: ollama (extensible later, e.g. openai-compatible)
MODEL_PROVIDER=ollama

# ---- Google Sheets (Developer B) ----
# The ID from the spreadsheet URL: /spreadsheets/d/<THIS_PART>/edit
GOOGLE_SHEETS_SPREADSHEET_ID=
# Path to the service-account JSON key file (kept OUTSIDE the repository)
GOOGLE_APPLICATION_CREDENTIALS=
# Optional: default email of the service account (for documentation/UX only)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Seconds between background reconciliation polls against the sheet
RECONCILIATION_POLL_SECONDS=60
